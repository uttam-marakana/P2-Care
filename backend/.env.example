# Development stays mock-first. Set false for Firebase-backed data/auth.
USE_MOCK_DATA=true

PORT=4000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development
ALLOW_MOCK_IN_PRODUCTION=false
API_RATE_LIMIT=120
PUBLIC_WRITE_RATE_LIMIT=20
AUTH_RATE_LIMIT=10

# Firebase Admin SDK (server-side only; never expose these in frontend env files)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Keep the surrounding quotes and use \n for line breaks when copied into .env.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional: seed an initial admin account when running `npm --workspace backend run firebase:seed`.
FIREBASE_ADMIN_EMAIL=admin@example.com
FIREBASE_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
FIREBASE_ADMIN_NAME=P2Care Admin

RESEND_API_KEY=re_YOUR_API_KEY
NOTIFICATION_FROM_EMAIL=P2Care Hospital <appointments@your-domain.com>
HOSPITAL_NOTIFICATION_EMAIL=appointments@your-domain.com

BACKEND_PUBLIC_URL=http://localhost:4000
