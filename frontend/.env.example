VITE_SITE_URL=https://www.example.com
VITE_API_BASE_URL=http://localhost:4000

# Admin development mode. Keep true for local mock mode.
VITE_USE_MOCK_DATA=true

# Firebase Web App configuration. These are safe client-side configuration values.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id

# WhatsApp click-to-chat destination (digits only, country code included)
VITE_WHATSAPP_NUMBER=9118001234567
