rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // P2Care does not expose Firestore directly to the browser.
    // All application reads/writes go through the protected Express API
    // using the Firebase Admin SDK. Admin SDK requests bypass these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
