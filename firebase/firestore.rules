rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // P2Care does not expose Firestore directly to the browser. The Express
    // API uses the Firebase Admin SDK, which bypasses these rules, and must
    // enforce authorization for every request.
    //
    // The API data model uses profiles/{uid}, appointments.patient_uid,
    // articles, services, contact_inquiries, and patient_reports. Public
    // collections and patient records must not be made client-readable here.
    // Keep direct client access denied unless the architecture and every
    // collection's ownership model are deliberately redesigned.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
